{
  "name": "word-tap",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm ocr:sync && vite",
    "build": "pnpm ocr:sync && tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "dictionary:build": "node --experimental-strip-types scripts/build-dictionary.ts",
    "ocr:sync": "node scripts/sync-ocr-assets.mjs"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "dexie": "^4.2.0",
    "foliate-js": "1.0.1",
    "mammoth": "^1.13.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.9.0",
    "read-excel-file": "^9.3.14",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "tesseract.js": "^7.0.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.56.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.0.0",
    "csv-parse": "^6.1.0",
    "ecdict": "0.0.4",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.4.0",
    "fake-indexeddb": "^6.2.0",
    "globals": "^16.0.0",
    "jsdom": "^27.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.0.0",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^4.0.0",
